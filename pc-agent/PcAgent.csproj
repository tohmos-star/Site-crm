<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PcAgent</AssemblyName>
    <RootNamespace>PcAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Нужен для dynamic-вызовов COM (WScript.Shell) в ShortcutManager —
         portable exe без инсталлятора сам создаёт себе ярлыки на рабочем
         столе/в "Пуск" при первом запуске. -->
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

</Project>
