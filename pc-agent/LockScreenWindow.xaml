<Window x:Class="PcAgent.LockScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="404 · станция заблокирована"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#10141B">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
            <TextBlock Text="404" Foreground="#3ED598" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>
            <TextBlock Text="Начните сессию на сайте или телефоне"
                       Foreground="#E7ECF3" FontSize="26" FontWeight="Bold"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
