<Window x:Class="PcAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="404 · станция" Height="380" Width="380"
        WindowStartupLocation="CenterScreen"
        Background="#10141B">
    <Grid Margin="24">

        <!-- Проверка станции при запуске / после действий -->
        <StackPanel x:Name="CheckingPanel" VerticalAlignment="Center">
            <TextBlock Text="Проверяем станцию…" Foreground="#8592A3" FontSize="13" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Станция свободна: ввод кода брони -->
        <StackPanel x:Name="CodePanel" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="404 · станция свободна" Foreground="#E7ECF3" FontSize="15" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Введите код брони" Foreground="#8592A3" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,0,0,18"/>
            <TextBox x:Name="CodeInput" FontFamily="Consolas" FontSize="24" Padding="10"
                     Background="#212B38" Foreground="#E7ECF3" BorderBrush="#2A3441"
                     MaxLength="6" HorizontalContentAlignment="Center"
                     TextChanged="CodeInput_TextChanged"/>
            <TextBlock x:Name="CodeErrorText" Foreground="#F0555A" FontSize="12" Margin="0,10,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>
            <Button x:Name="CodeSubmitButton" Content="Подтвердить" Margin="0,14,0,0" Padding="0,11"
                    Background="#212B38" Foreground="#8592A3" BorderThickness="0" IsEnabled="False"
                    Click="CodeSubmitButton_Click"/>
            <TextBlock Text="Сменить токен станции" Foreground="#8592A3" FontSize="11" Margin="0,12,0,0"
                       HorizontalAlignment="Center" TextDecorations="Underline" Cursor="Hand"
                       MouseLeftButtonUp="ChangeToken_Click"/>
        </StackPanel>

        <!-- Активная сессия -->
        <StackPanel x:Name="SessionPanel" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="StationNameText" Foreground="#E7ECF3" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="BalanceText" Foreground="#8592A3" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock x:Name="TimerText" Foreground="#3ED598" FontFamily="Consolas" FontSize="40" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock x:Name="SessionStatusText" Foreground="#8592A3" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,16"/>
            <UniformGrid Columns="2" Rows="1">
                <Button x:Name="Extend30Button" Content="+30 мин" Margin="0,0,4,0" Padding="0,10"
                        Background="#212B38" Foreground="#E7ECF3" BorderThickness="0" Click="Extend30Button_Click"/>
                <Button x:Name="Extend60Button" Content="+60 мин" Margin="4,0,0,0" Padding="0,10"
                        Background="#212B38" Foreground="#E7ECF3" BorderThickness="0" Click="Extend60Button_Click"/>
            </UniformGrid>
            <UniformGrid Columns="2" Rows="1" Margin="0,8,0,0">
                <Button x:Name="CompleteButton" Content="Завершить" Margin="0,0,4,0" Padding="0,10"
                        Background="#212B38" Foreground="#E7ECF3" BorderThickness="0" Click="CompleteButton_Click"/>
                <Button x:Name="SupportButton" Content="Техподдержка" Margin="4,0,0,0" Padding="0,10"
                        Background="#1A212B" Foreground="#8592A3" BorderThickness="0" Click="SupportButton_Click"/>
            </UniformGrid>
            <TextBlock x:Name="SessionErrorText" Foreground="#F0555A" FontSize="12" Margin="0,10,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>

    </Grid>
</Window>
